{
  "openapi": "3.1.0",
  "info": {
    "title": "OTO 家政服务平台 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/orders": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "下单",
        "description": "创建一笔订单，返回订单摘要。",
        "operationId": "create_order_api_v1_orders_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_no}/start": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "师傅开工",
        "description": "开工：订单从「已接单」流转到「服务中」。",
        "operationId": "start_order_service_api_v1_orders__order_no__start_post",
        "parameters": [
          {
            "name": "order_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order No"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceFlowResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_no}/finish": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "师傅完工",
        "description": "完工：订单从「服务中」流转到「待确认」，等客户确认。",
        "operationId": "finish_order_service_api_v1_orders__order_no__finish_post",
        "parameters": [
          {
            "name": "order_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order No"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceFlowResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_no}/confirm": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "客户确认完成",
        "description": "客户确认完成：订单从「待确认」流转到「已完成」，并写入完工时间。",
        "operationId": "confirm_order_service_api_v1_orders__order_no__confirm_post",
        "parameters": [
          {
            "name": "order_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order No"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceFlowResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pay/mock-notify": {
      "post": {
        "tags": [
          "pay"
        ],
        "summary": "mock 支付回调（仅 dev）",
        "description": "模拟支付成功回调，把订单推进到待派单。\n\n幂等：重复回调同一笔订单不会重复改状态、重复写状态流转日志。",
        "operationId": "mock_pay_notify_api_v1_pay_mock_notify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MockPayNotifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MockPayResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_id}/dispatch": {
      "post": {
        "tags": [
          "dispatch"
        ],
        "summary": "派单",
        "description": "把订单派给本商师傅，订单转为「待接单」。",
        "operationId": "dispatch_order_api_v1_orders__order_id__dispatch_post",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DispatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DispatchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_no}/accept": {
      "post": {
        "tags": [
          "master-action"
        ],
        "summary": "师傅接单",
        "description": "接下派给自己的订单，订单转为「已接单」。",
        "operationId": "accept_order_api_v1_orders__order_no__accept_post",
        "parameters": [
          {
            "name": "order_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order No"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_no}/reject": {
      "post": {
        "tags": [
          "master-action"
        ],
        "summary": "师傅拒单",
        "description": "拒掉派给自己的订单，订单退回「待派单」，清空承接师傅。",
        "operationId": "reject_order_api_v1_orders__order_no__reject_post",
        "parameters": [
          {
            "name": "order_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order No"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settlements/{settlement_id}/confirm": {
      "post": {
        "tags": [
          "settlements"
        ],
        "summary": "财务确认结算",
        "description": "确认一张待结算的结算单，关联订单一并转为「已结算」。\n\n角色不对返回 403；结算单不存在或已被确认返回 404（两种情况同构）。",
        "operationId": "confirm_settlement_api_v1_settlements__settlement_id__confirm_post",
        "parameters": [
          {
            "name": "settlement_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Settlement Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmSettlementResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptResult": {
        "properties": {
          "order_no": {
            "type": "string",
            "title": "Order No",
            "description": "订单号"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "订单状态"
          },
          "master_id": {
            "type": "integer",
            "title": "Master Id",
            "description": "承接订单的师傅 ID"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_no",
          "status",
          "master_id"
        ],
        "title": "AcceptResult",
        "description": "接单成功后的结果。"
      },
      "ConfirmSettlementResult": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "结算单 ID"
          },
          "status": {
            "$ref": "#/components/schemas/SettlementStatus",
            "description": "结算单状态（确认后为 CONFIRMED）"
          },
          "net_amount": {
            "type": "string",
            "title": "Net Amount",
            "description": "服务商实收金额"
          },
          "confirmed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed At",
            "description": "确认时间（确认后非空）"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "net_amount"
        ],
        "title": "ConfirmSettlementResult",
        "description": "确认结算后的结算单状态。"
      },
      "DispatchRequest": {
        "properties": {
          "master_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Master Id",
            "description": "承接订单的师傅 ID"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "master_id"
        ],
        "title": "DispatchRequest",
        "description": "派单请求体。"
      },
      "DispatchResult": {
        "properties": {
          "order_no": {
            "type": "string",
            "title": "Order No",
            "description": "订单号"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "订单状态"
          },
          "master_id": {
            "type": "integer",
            "title": "Master Id",
            "description": "承接订单的师傅 ID"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_no",
          "status",
          "master_id"
        ],
        "title": "DispatchResult",
        "description": "派单成功后的结果。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MockPayNotifyRequest": {
        "properties": {
          "order_no": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Order No",
            "description": "订单号"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_no"
        ],
        "title": "MockPayNotifyRequest",
        "description": "mock 支付回调的请求体。"
      },
      "MockPayResult": {
        "properties": {
          "order_no": {
            "type": "string",
            "title": "Order No"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "pay_status": {
            "$ref": "#/components/schemas/PayStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_no",
          "status",
          "pay_status"
        ],
        "title": "MockPayResult",
        "description": "mock 支付回调的响应体。\n\n只回三个字段：订单号、订单状态、支付状态。不回金额、不回用户信息。"
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "PENDING_PAY",
          "PENDING_DISPATCH",
          "PENDING_ACCEPT",
          "ACCEPTED",
          "IN_SERVICE",
          "PENDING_CONFIRM",
          "COMPLETED",
          "PENDING_SETTLE",
          "SETTLED",
          "CANCELLED",
          "REFUNDING",
          "REFUNDED"
        ],
        "title": "OrderStatus",
        "description": "订单状态机取值（12 态，流转由状态机函数负责）。"
      },
      "OrderSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "订单 ID"
          },
          "order_no": {
            "type": "string",
            "title": "Order No",
            "description": "订单号"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "订单状态"
          },
          "amount": {
            "type": "string",
            "title": "Amount",
            "description": "订单金额（服务端按服务项基准价快照）"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "order_no",
          "status",
          "amount"
        ],
        "title": "OrderSummary",
        "description": "下单成功后的订单摘要。"
      },
      "PayStatus": {
        "type": "string",
        "enum": [
          "UNPAID",
          "PAID",
          "REFUNDING",
          "REFUNDED"
        ],
        "title": "PayStatus",
        "description": "订单支付状态。"
      },
      "PlaceOrderRequest": {
        "properties": {
          "item_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Item Id",
            "description": "服务项 ID"
          },
          "slot_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Slot Id",
            "description": "预约时段 ID"
          },
          "address_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Address Id",
            "description": "收货地址 ID"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "slot_id",
          "address_id"
        ],
        "title": "PlaceOrderRequest",
        "description": "下单请求体。\n\n字段集合就是 ``{item_id, slot_id, address_id}``，多一个少一个都算破坏契约\n（有测试盯着）。"
      },
      "RejectRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Reason",
            "description": "拒单原因，会原样写进订单状态流转日志"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "RejectRequest",
        "description": "拒单请求体。"
      },
      "RejectResult": {
        "properties": {
          "order_no": {
            "type": "string",
            "title": "Order No",
            "description": "订单号"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "订单状态"
          },
          "master_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Master Id",
            "description": "承接订单的师傅 ID（拒单后为空）"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_no",
          "status",
          "master_id"
        ],
        "title": "RejectResult",
        "description": "拒单成功后的结果。\n\nmaster_id 为空：拒单后订单退回「待派单」，当前没有承接师傅。"
      },
      "ServiceFlowResult": {
        "properties": {
          "order_no": {
            "type": "string",
            "title": "Order No",
            "description": "订单号"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "流转后的订单状态"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At",
            "description": "完工时间（订单完成时非空）"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_no",
          "status"
        ],
        "title": "ServiceFlowResult",
        "description": "服务流转动作执行后的订单状态。"
      },
      "SettlementStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "CONFIRMED"
        ],
        "title": "SettlementStatus",
        "description": "结算单状态。\n\nPENDING：待结算（由 T+1 定时任务生成，等待服务商确认）。\nCONFIRMED：已确认（服务商确认过金额，等待打款）。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
