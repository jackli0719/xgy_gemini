# OTO 家政服务平台 —— 环境变量示例
# 复制为 .env 后按实际环境填写；.env 不得提交到 Git。
# 说明：支付、对象存储、监控与 AI 审查凭证由后续任务卡引入，本文件暂不包含。

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DB_ECHO=false
DB_POOL_SIZE=10
# 以下三项供本地 Docker Compose 的 postgres 服务初始化库与账号使用
POSTGRES_USER=<数据库用户名>
POSTGRES_PASSWORD=<数据库密码>
POSTGRES_DB=<数据库名>
# postgres 在宿主机的映射端口：本机 5432 已被别的 postgres 占用时改这里
# （只影响宿主机端口，容器内部仍是 5432）
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_URL=redis://<host>:6379/0
REDIS_PASSWORD=
# redis 在宿主机的映射端口：本机 6379 已被别的 redis 占用时改这里
REDIS_PORT=6379

# ===== JWT =====
# 至少 32 字节（RFC 7518 对 HS256 的下限）；短于 32 字节应用会拒绝启动。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ALG=HS256
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=30

# ===== 登录 =====
# 短信验证码。
# MVP 占位：不接短信网关，所有手机号都用这一个固定验证码登录。
# - dev：留空即可，默认用 123456。
# - 生产（APP_ENV 不是 dev）：必须填一个至少 8 位的随机值，
#   留空 / 用 123456 / 短于 8 位都会让应用在启动阶段直接拒绝启动。
#   生成命令：python -c "import secrets; print(secrets.token_urlsafe(12))"
LOGIN_SMS_CODE=

# ===== 应用 =====
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TENANT_STRICT_MODE=true

# ===== 时区 =====
# 业务时区：所有「业务日期」都按它算——今天是哪天、下单时段是不是还在将来、
# 超时自动确认的 N 小时、T+1 结算。默认 Asia/Shanghai。
# 存库时间戳仍是 UTC（timestamptz），只在「取业务日期」时换算。
# 必须是系统认识的时区名（如 Asia/Shanghai、UTC），写错会拒绝启动。
TIMEZONE=Asia/Shanghai

# ===== 超时自动确认 ========
# 订单停在「待确认」超过多少小时就由系统自动确认（必须为正整数）。
# 定时任务入口：cd apps/api && python -m app.scripts.auto_confirm_job
AUTO_CONFIRM_THRESHOLD_HOURS=24

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FORMAT=json
