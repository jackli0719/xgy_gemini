# OTO 家政服务平台 —— 环境变量示例
# 复制为 .env 后按实际环境填写；.env 不得提交到 Git。
# 说明：支付、对象存储、监控与 AI 审查凭证由后续任务卡引入，本文件暂不包含。

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DB_ECHO=false
DB_POOL_SIZE=10
# 以下三项供本地 Docker Compose 的 postgres 服务初始化库与账号使用
POSTGRES_USER=<数据库用户名>
POSTGRES_PASSWORD=<数据库密码>
POSTGRES_DB=<数据库名>
# postgres 在宿主机的映射端口：本机 5432 已被别的 postgres 占用时改这里
# （只影响宿主机端口，容器内部仍是 5432）
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_URL=redis://<host>:6379/0
REDIS_PASSWORD=
# redis 在宿主机的映射端口：本机 6379 已被别的 redis 占用时改这里
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=<32位以上随机字符串>
JWT_ALG=HS256
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=30

# ===== 应用 =====
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TENANT_STRICT_MODE=true

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FORMAT=json
